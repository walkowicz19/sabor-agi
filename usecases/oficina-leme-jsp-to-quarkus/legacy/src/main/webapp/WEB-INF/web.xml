<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">
    <display-name>Oficina Leme</display-name>

    <servlet>
        <servlet-name>login</servlet-name>
        <servlet-class>br.sabor.leme.jsp.auth.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>login</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>requisitions</servlet-name>
        <servlet-class>br.sabor.leme.jsp.counter.RequisitionServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>requisitions</servlet-name>
        <url-pattern>/requisitions</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>bin-transfer</servlet-name>
        <servlet-class>br.sabor.leme.jsp.counter.BinTransferServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>bin-transfer</servlet-name>
        <url-pattern>/transfer</url-pattern>
    </servlet-mapping>
</web-app>
